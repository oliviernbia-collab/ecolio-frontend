# Écolio — site React (ecolio.site)
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Validation des certificats SSL (AutoSSL / Let's Encrypt) : jamais redirigée ni réécrite
  RewriteRule ^\.well-known/ - [L]

  # Forcer HTTPS (le cookie de session n'est envoyé qu'en HTTPS en production)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # /api est servi par l'application Node.js (Setup Node.js App) : ne pas y toucher
  RewriteRule ^api(/|$) - [L]

  # Fichiers et dossiers existants : servis tels quels
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Toutes les autres adresses (/login, /settings, /contact...) : application React
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"

  # index.html jamais mis en cache (pour que les mises à jour soient vues tout de suite)
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  # Fichiers de /assets : noms uniques à chaque build, cache long
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
